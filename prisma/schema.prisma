// Anneal — veritabanı şeması
//
// Bu dosya SCHEMA.md v1.3'ten türetilmiştir. SCHEMA.md tek kaynaktır.
// Tablo ve alan adları SCHEMA.md ile birebir aynı tutuldu ki satır satır
// karşılaştırılabilsin. Alan adlarının snake_case olmasının sebebi budur.
//
// Belirsiz noktaların nasıl çözüldüğü docs/KARARLAR.md dosyasında yazılıdır.
//
// Hiçbir ilişkide silme davranışı tanımlanmadı: veri kuralları gereği satır
// silinmez, Prisma varsayılanı da zaten silmeyi engeller.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"

  // Uretilen dosyalarin ic ice aktarmalarina .ts uzantisi ekler.
  // Sebebi: Node ESM uzantisiz cozemiyor, seed script'i istemciyi
  // dogrudan calistirabilsin diye.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  // Bağlantı adresi prisma.config.ts içinde (Prisma 7 kuralı)
}

// ---------------------------------------------------------------------------
// Enum'lar — SCHEMA.md bölüm 1 ve 2
// Takma adların sebebi docs/KARARLAR.md, K7. Veritabanındaki değerler değişmez.
// ---------------------------------------------------------------------------

enum Source {
  manual
  dev_seed     @map("dev-seed")
  manufacturer
  affiliate
  user
  import
}

enum Confidence {
  high
  medium
  low
}

enum PartCategory {
  gpu
  cpu
  motherboard
  ram
  psu
  storage
  case
}

// motherboard ve ram tek bellek tipi destekler
enum MemoryType {
  DDR4
  DDR5
}

// cpu ikisini birden destekleyebilir
enum CpuMemoryType {
  DDR4
  DDR5
  DDR4_DDR5 @map("DDR4/DDR5")
}

enum FormFactor {
  ATX
  mATX
  ITX
  E_ATX @map("E-ATX")
}

enum Modularity {
  full
  semi
  none
}

enum StorageType {
  nvme
  sata_ssd @map("sata-ssd")
  hdd
}

enum Resolution {
  R1080p @map("1080p")
  R1440p @map("1440p")
  R2160p @map("2160p")
}

enum Preset {
  low
  medium
  high
  ultra
}

// Render modu. Raytracing FPS'i %30-50 degistirir; upscaling kadar belirleyici
// bir ayar oldugu icin kendi alani var (K111). pathtracing bugun kullanilmiyor
// ama simdi tanimlandi: sonradan eklenirse bugunku satirlarin modu geriye
// donuk tahmin edilmek zorunda kalirdi.
enum RenderMode {
  raster
  raytracing
  pathtracing
}

enum BenchmarkSourceType {
  review
  user_submission
  own_test
}

// Bir ölçümün / indeksin hangi iş yüküne ait olduğu (K35).
// Beta'da yalnızca `gaming` kullanılır; diğer üçü şemada hazır bekler.
// Varsayılan değeri bilinçli olarak yok: iş yükü söylenmeden satır yazılamaz.
enum Workload {
  gaming
  ai_inference
  video_encode
  productivity
}

// shader_units'in ne saydigi (K57). Markalar arasi karsilastirilabilir degil;
// tip etiketi bu kisiti satirin kendisine yaziyor.
enum ShaderUnitType {
  cuda_core          // NVIDIA
  stream_processor   // AMD
  xe_vector_engine   // Intel — ~16 kat kucuk olcekte
}

enum ImportStatus {
  pending
  processed
  failed
}

// ---------------------------------------------------------------------------
// Bölüm 2 — Parça kataloğu
//
// Spec tablolarında part_id birincil anahtardır, ayrı id yoktur (K2).
// Hepsi olgusal iddia taşır, dolayısıyla hepsinde source/source_url/
// confidence/collected_at bulunur (K3).
// ---------------------------------------------------------------------------

model Part {
  id           String       @id // slug — bir kez atanır, asla değişmez
  category     PartCategory
  brand        String
  model        String
  release_year Int?
  is_active    Boolean      @default(true) // piyasadan kalktıysa false, satır silinmez

  // Olgusal iddia alanları — bölüm 1.3
  source       Source
  source_url   String?
  confidence   Confidence
  collected_at DateTime @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  gpu_specs         GpuSpecs?
  // Bu parca bir kartsa kendi varyant satiri; bir cipse o cipin kartlari (K86).
  // Iki ayri iliski cunku ayni tablo iki farkli rolde baglaniyor.
  gpu_variant_specs GpuVariantSpecs?  @relation("variant_part")
  gpu_variants      GpuVariantSpecs[] @relation("variant_chip")
  cpu_specs         CpuSpecs?
  motherboard_specs MotherboardSpecs?
  ram_specs         RamSpecs?
  psu_specs         PsuSpecs?
  storage_specs     StorageSpecs?
  case_specs        CaseSpecs?
  price_snapshots   PriceSnapshot[]
  perf_index        PerfIndex[]
  build_items       BuildItem[]
  click_events      ClickEvent[]
  benchmarks_as_gpu BenchmarkPoint[]  @relation("benchmark_gpu")
  benchmarks_as_cpu BenchmarkPoint[]  @relation("benchmark_cpu")

  @@index([category])
  @@index([source]) // dev-seed filtresi bu sütun üzerinden çalışır
  @@map("parts")
}

model GpuSpecs {
  part_id String @id
  part    Part   @relation(fields: [part_id], references: [id])

  chipset              String
  vram_gb              Int
  vram_type            String
  tdp_watt             Int
  // Opsiyonel (K52): ureticiler yalnizca kendi referans kartlarinin olcusunu
  // verir. Bilinmeyen uzunluk, uzunlugu olmayan kart demek degil.
  length_mm            Int?
  // Opsiyonel (K56): AMD urun sayfalari bu ikisini yayinlamiyor. Hicbir
  // uyumluluk kurali ve arayuz bu alanlari kullanmiyor.
  recommended_psu_watt Int?
  pcie_version         String?

  // Nesiller arasi degil, ayni mimari icinde goreli olcekleme icin (K51).
  // Opsiyonel: ureticinin her sayfasinda bulunmuyor.
  shader_units         Int?
  shader_unit_type     ShaderUnitType?
  boost_clock_mhz      Int?
  memory_bandwidth_gbs Float?

  // Indeks tahmini icin (K154). Ikisi de uc ureticinin de yayinladigi alanlar.
  //
  // bus_width_bits, memory_bandwidth_gbs'in YERINE gecen olcu:
  // bant genisligi = veri yolu x bellek hizi / 8, ve NVIDIA bu carpimin
  // yalnizca ilk terimini yayinliyor (30 karttan 27'sinde bant genisligi yok).
  // Yarisi bos bir sutun tahmin ekseni olamaz.
  bus_width_bits       Int?
  // "Blackwell", "Ada Lovelace", "RDNA 4", "Xe2". Tahmin once aile icinde
  // yapiliyor ve shader_units yalnizca ayni mimaride anlamli (K57), bu yuzden
  // aile bilgisi satirin kendisinde durmak zorunda -- parca adindan tahmin
  // edilemez.
  architecture_family  String?

  source       Source
  source_url   String?
  confidence   Confidence
  collected_at DateTime @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("gpu_specs")
}

// Ekran karti varyanti (AIB karti) — SCHEMA.md bolum 2, K86.
//
// gpu_specs cip seviyesidir (RTX 5080). Piyasada satilan karttir ve ayni cipten
// cikan iki kart farklidir: ROG Strix ~358 mm, ProArt ~304 mm. Kart, kategorisi
// gpu olan normal bir parts satiridir; bu tablo onu cipine baglar.
//
// Degismeyen alanlar (VRAM, shader, bellek hizi, PCIe) burada TEKRARLANMAZ,
// chip_part_id uzerinden gpu_specs'ten okunur.
model GpuVariantSpecs {
  part_id String @id
  part    Part   @relation("variant_part", fields: [part_id], references: [id])

  // Tek zorunlu alan (K86): C4/C5 geri dusulu, perf_index cozumlemesi ve
  // degismeyen speclerin okunmasi bu bagi kullanir. Cipi bilinmeyen kart olmaz.
  chip_part_id String
  chip         Part   @relation("variant_chip", fields: [chip_part_id], references: [id])

  // Fizik olculer — asla zorunlu olmaz (K62). length_mm'i C5 kullanir.
  // thickness_slots ondalikli: 2.5 slot gercek bir deger, asagi yuvarlamak
  // karti oldugundan ince gosterir (K59'un yuvarlama maddesi kasa acikliklari icin).
  length_mm       Int?
  height_mm       Int?
  thickness_slots Float?

  // tbp_watt'i C4 kullanir ama opsiyonel: zorunlu olsaydi TBP yayinlamayan
  // uretici kartini disarida birakirdi (K56, pcie_version dersi).
  tbp_watt             Int?
  recommended_psu_watt Int?
  // Serbest metin (K88): "2x 8-pin + 1x 6-pin". Hicbir kural okumuyor, o yuzden
  // yapilandirilmis hali ertelendi — SORULAR.md S38.
  power_connectors     String?

  // Fabrika saatleri. K37/K74: bu iki alandan indeks TURETILMEZ, yalnizca
  // gosterim ve kaynak defteri icin. Binning alani yok — uretici yayinlamiyor.
  boost_clock_mhz    Int?
  boost_clock_oc_mhz Int?

  fan_count         Int?
  hdmi_count        Int?
  displayport_count Int?
  usb_c_count       Int?

  source       Source
  source_url   String?
  confidence   Confidence
  collected_at DateTime @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([chip_part_id])
  @@map("gpu_variant_specs")
}

model CpuSpecs {
  part_id String @id
  part    Part   @relation(fields: [part_id], references: [id])

  socket          String
  cores           Int
  threads         Int
  base_clock_mhz  Int
  boost_clock_mhz Int
  tdp_watt        Int
  memory_type     CpuMemoryType
  has_igpu        Boolean

  // Indeks tahmini icin (K154). Oyun yukunde islemciler arasindaki farki
  // cekirdek sayisi ve saat hizi aciklamiyor: olculen 12 islemcide X3D
  // parcalari DAHA DUSUK cekirdekxsaat degeriyle DAHA YUKSEK indeks aliyor.
  // Fark yigilmis onbellekten geliyor.
  l3_cache_mb     Int?

  source       Source
  source_url   String?
  confidence   Confidence
  collected_at DateTime @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("cpu_specs")
}

model MotherboardSpecs {
  part_id String @id
  part    Part   @relation(fields: [part_id], references: [id])

  socket               String
  chipset              String
  form_factor          FormFactor
  memory_type          MemoryType
  memory_slots         Int
  max_memory_gb        Int
  max_memory_speed_mhz Int
  m2_slots             Int

  source       Source
  source_url   String?
  confidence   Confidence
  collected_at DateTime @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("motherboard_specs")
}

model RamSpecs {
  part_id String @id
  part    Part   @relation(fields: [part_id], references: [id])

  memory_type  MemoryType
  capacity_gb  Int // tek modül değil, kit toplamı
  module_count Int
  speed_mhz    Int
  cas_latency  Int

  source       Source
  source_url   String?
  confidence   Confidence
  collected_at DateTime @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("ram_specs")
}

model PsuSpecs {
  part_id String @id
  part    Part   @relation(fields: [part_id], references: [id])

  wattage           Int
  // Opsiyonel (K61): her uretici ayni sertifika sistemini yayinlamiyor
  // (80 PLUS / Cybenetics) ve hicbir kural bu alani kullanmiyor.
  efficiency_rating String?
  modularity        Modularity
  // Opsiyonel (K62): fiziksel olcu alanlari asla zorunlu olmaz.
  length_mm         Int?

  source       Source
  source_url   String?
  confidence   Confidence
  collected_at DateTime @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("psu_specs")
}

model StorageSpecs {
  part_id String @id
  part    Part   @relation(fields: [part_id], references: [id])

  storage_type   StorageType
  capacity_gb    Int
  interface      String
  read_speed_mbs Int?

  source       Source
  source_url   String?
  confidence   Confidence
  collected_at DateTime @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("storage_specs")
}

model CaseSpecs {
  part_id String @id
  part    Part   @relation(fields: [part_id], references: [id])

  // Enum dizisi (K5): C6 kuralı bunu motherboard_specs.form_factor ile
  // karşılaştırdığı için yazım hatası veritabanı seviyesinde engelleniyor.
  supported_form_factors   FormFactor[]
  // Üçü de opsiyonel (K62): fiziksel ölçü alanı zorunlu yapılmaz. Fractal
  // Design üçünü de yayınlıyor ama bu bir üreticinin alışkanlığı, kural değil.
  // Eksikse C5 ve W5 kendini atlar, arayüz kullanıcıya bildirir.
  max_gpu_length_mm        Int?
  max_cpu_cooler_height_mm Int?
  max_psu_length_mm        Int?

  source       Source
  source_url   String?
  confidence   Confidence
  collected_at DateTime @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("case_specs")
}

// ---------------------------------------------------------------------------
// Bölüm 3 — Fiyat
// Append-only: UPDATE yazılmaz, bu yüzden updated_at yoktur (K1).
// ---------------------------------------------------------------------------

model PriceSnapshot {
  id      String @id @default(uuid())
  part_id String
  part    Part   @relation(fields: [part_id], references: [id])

  retailer    String
  price_minor Int // kuruş — 149999 = 1.499,99 TL. Float asla kullanılmaz.
  currency    String
  in_stock    Boolean?
  product_url String?

  source       Source
  source_url   String?
  confidence   Confidence
  collected_at DateTime @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // güncel fiyat = en son collected_at'li satır, sorgu bu indeksten faydalanır
  @@index([part_id, collected_at])
  @@map("price_snapshots")
}

// ---------------------------------------------------------------------------
// Bölüm 4 — Benchmark ve performans
// ---------------------------------------------------------------------------

model Game {
  id           String @id // slug: cyberpunk-2077
  name         String
  // Opsiyonel (K112): hicbir kural ve arayuz kullanmiyor (K56 olcutu) ve her
  // oyun Steam'de bulunmuyor -- Alan Wake 2 Epic'e ozel cikti. Zorunluluk,
  // dogrulanamayan bir yili uydurmaya zorlardi. Deger PC cikis yilidir.
  release_year Int?
  gpu_weight   Float // 0-1, oyunun GPU'ya bağımlılığı
  cpu_weight   Float // 0-1

  source       Source
  source_url   String?
  confidence   Confidence
  collected_at DateTime @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  benchmark_points BenchmarkPoint[]

  @@map("games")
}

// append-only (K1) — elle toplanan gerçek ölçümler, motorun kalibrasyon verisi
model BenchmarkPoint {
  id          String  @id @default(uuid())
  gpu_part_id String
  gpu_part    Part    @relation("benchmark_gpu", fields: [gpu_part_id], references: [id])
  cpu_part_id String? // bilinmiyorsa null
  cpu_part    Part?   @relation("benchmark_cpu", fields: [cpu_part_id], references: [id])
  game_id     String
  game        Game    @relation(fields: [game_id], references: [id])

  workload            Workload // beta'da hep 'gaming' (K35)
  resolution          Resolution
  preset              Preset
  upscaling           String?
  // Varsayilan raster: kaynaklarin cogu raster olcuyor ve mevcut satirlarin
  // hepsi oyleydi. Varsayilan olmasi, olcumu girenin modu soylememesine izin
  // vermek degil -- ice aktarici CSV'de sutunu bekliyor.
  render_mode         RenderMode @default(raster)
  avg_fps             Float
  one_percent_low_fps Float?

  source_type  BenchmarkSourceType
  source       Source
  source_url   String // burada zorunlu (K4) — kaynağı olmayan ölçüm veri değil gürültüdür
  confidence   Confidence
  collected_at DateTime @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([gpu_part_id, game_id, resolution])
  @@map("benchmark_points")
}

// hesaplanmış, sürümlü — eski model_version satırları silinmez
model PerfIndex {
  id      String @id @default(uuid())
  part_id String // sadece gpu ve cpu
  part    Part   @relation(fields: [part_id], references: [id])

  workload      Workload // beta'da hep 'gaming' (K35)
  index_value   Float // 0-100
  model_version String
  computed_at   DateTime @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Bir parçanın, bir iş yükünde, bir motor sürümünde tek indeksi olur (K35;
  // K14'ün tekillik kısmını değiştirir). Aynı kart oyunda ve AI çıkarımında
  // farklı skor alabilir; workload kısıtta olmasaydı biri diğerinin üzerine
  // yazardı. Yeniden hesap aynı satırı günceller; "ne zaman hesaplandı"
  // bilgisini computed_at taşır, bu yüzden updated_at yoktur.
  @@unique([part_id, workload, model_version])
  @@map("perf_index")
}

// ---------------------------------------------------------------------------
// Bölüm 5 — Sistemler
// Olgusal iddia taşımaz (kullanıcının kendi eylemi), muaf (K3).
// ---------------------------------------------------------------------------

model Build {
  id                  String  @id // kısa, paylaşılabilir slug: k3n9x2
  title               String? // kullanıcının verdiği ad
  // Opsiyonel (K124): fiyati olmayan parca iceren sistem de kaydedilir ve
  // toplam null olur. Kismi toplam YAZILMAZ -- oldugundan ucuz gorunur ve
  // dondugu icin sonradan duzeltilemez (K92 ile ayni mantik).
  total_price_minor   Int? // kayıt anında dondurulur
  currency            String?

  // Kullanıcının kaydettiği çözünürlük (K43). İndeks bu çözünürlükte
  // hesaplanır; yazılmasaydı dondurulan sayı neyi ifade ettiği bilinmeyen
  // bir sayı olurdu. İndeks hesaplanamasa da doldurulur.
  resolution Resolution

  // Ekran kartsız (iGPU) sistemin indeksi hesaplanamaz — perf_index yalnızca
  // gpu ve cpu için vardır. Zorunlu kalsaydı geçerli bir sistem kaydedilemezdi
  // (K44). null "indeks sıfır" değil, "hesaplanamadı" demektir.
  perf_index_snapshot Float?
  model_version       String // kayıt anındaki motor sürümü

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  build_items  BuildItem[]
  click_events ClickEvent[]
  feedback     Feedback[]

  @@map("builds")
}

model BuildItem {
  build_id String
  build    Build  @relation(fields: [build_id], references: [id])
  part_id  String
  part     Part   @relation(fields: [part_id], references: [id])

  quantity                 Int
  // Opsiyonel (K124): kayit aninda fiyati olmayan parca da kaydedilebilir.
  unit_price_minor_at_save Int?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  // Bileşik anahtar (K2): aynı parça bir sistemde iki satır olamaz.
  @@id([build_id, part_id])
  @@map("build_items")
}

// ---------------------------------------------------------------------------
// Bölüm 6 — Yardımcı tablolar
// Olgusal iddia taşımaz, muaf (K3).
// ---------------------------------------------------------------------------

model RawImport {
  id          String       @id @default(uuid())
  source      String // bilinçli istisna (K6): enum değil, serbest metin
  payload     Json
  imported_at DateTime     @db.Timestamptz(6)
  status      ImportStatus
  error       String?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("raw_imports")
}

model ClickEvent {
  id       String  @id @default(uuid())
  part_id  String
  part     Part    @relation(fields: [part_id], references: [id])
  build_id String?
  build    Build?  @relation(fields: [build_id], references: [id])

  target_url String

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("click_events")
}

model Feedback {
  id       String  @id @default(uuid())
  message  String
  build_id String?
  build    Build?  @relation(fields: [build_id], references: [id])
  page_url String?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("feedback")
}
